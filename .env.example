HOST=0.0.0.0
PORT=80
WEBHOOK_PATH=/webhook/openwa
WEBHOOK_SECRET=
OPENWA_URL=http://192.168.1.245:2785/
OPENWA_API_KEY=PASTE_YOUR_OPENWA_API_KEY_HERE
OPENWA_SESSION_ID=
NVIDIA_API_KEY=PASTE_YOUR_NVIDIA_API_KEY_HERE
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_TEMPERATURE=0.2
NVIDIA_MAX_TOKENS=500

# Random delay before processing each message (30 seconds to 30 minutes)
MESSAGE_DELAY_MIN_MS=30000
MESSAGE_DELAY_MAX_MS=1800000
LOG_DIR=./logs
CONTEXT_DIR=./contexts
CONTEXT_MAX_MESSAGES=20







# Wait one minute before retrying a failed NVIDIA request
NVIDIA_RETRY_DELAY_MS=60000
